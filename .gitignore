# Provider plugins and init artifacts
.terraform/

# This is a reusable child module, not a root module: the dependency lock
# belongs to the configuration that calls it, which pins its own providers.
.terraform.lock.hcl

# State never belongs here — the module holds none of its own
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Plans embed rendered configuration and any secret a variable carried
*.tfplan
*.tfplan.*

# Variable files routinely carry API tokens
*.tfvars
*.tfvars.json

# CLI configuration may contain credentials
.terraformrc
terraform.rc

# Terraform test / module-call scratch directories
.terraform.tfstate.lock.info

# Add module-specific artifacts below, e.g. credentials the module retrieves:
# kubeconfig
# *.pem
